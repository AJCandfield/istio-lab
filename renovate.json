{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enablePreCommit",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitTypeAll(chore)"
  ],
  "dependencyDashboard": true,
  "enabledManagers": [
    "custom.regex",
    "flux",
    "github-actions",
    "kubernetes",
    "mise",
    "pre-commit",
    "terraform"
  ],
  "flux": {
    "managerFilePatterns": [
      "/(^|/)k8s/.+\\.ya?ml$/",
      "/(^|/)live/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)k8s/.+\\.ya?ml$/",
      "/(^|/)live/.+\\.ya?ml$/",
      "/(^|/)tools/debug-curl/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)infra/live/.+/cluster\\.hcl$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\s+[a-z_]+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "minimumReleaseAge": "14 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "schedule": [
    "before 6am on monday"
  ],
  "packageRules": [
    {
      "description": "Group and automerge non-major Mise tool updates",
      "matchManagers": [
        "mise"
      ],
      "matchDepTypes": [
        "tools"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "Mise tool updates",
      "groupSlug": "mise-tool-updates",
      "automerge": true
    },
    {
      "description": "Keep major updates manual",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
