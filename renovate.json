{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enablePreCommit",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitTypeAll(chore)"
  ],
  "dependencyDashboard": true,
  "enabledManagers": [
    "flux",
    "github-actions",
    "kubernetes",
    "mise",
    "pre-commit"
  ],
  "flux": {
    "managerFilePatterns": [
      "/(^|/)flux/.+\\.ya?ml$/"
    ]
  },
  "minimumReleaseAge": "14 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "schedule": [
    "before 6am on monday"
  ],
  "packageRules": [
    {
      "description": "Group and automerge non-major Mise tool updates",
      "matchManagers": [
        "mise"
      ],
      "matchDepTypes": [
        "tools"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "Mise tool updates",
      "groupSlug": "mise-tool-updates",
      "automerge": true
    },
    {
      "description": "Group Istio Helm chart updates",
      "matchManagers": [
        "flux"
      ],
      "matchFileNames": [
        "flux/components/istio/*.yaml"
      ],
      "groupName": "Istio Helm charts",
      "groupSlug": "istio-helm-charts"
    },
    {
      "description": "Keep major updates manual",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
